{
  "name": "energie-nomade",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/minify-public.mjs && node scripts/write-redirects.mjs",
    "preview": "astro preview",
    "check:affiliate": "node scripts/check-affiliate.mjs",
    "check:secrets": "node scripts/check-secrets.mjs",
    "check:prod": "node scripts/check-placeholders.mjs",
    "check:headers": "node scripts/check-headers.mjs",
    "check:links": "node scripts/check-links.mjs",
    "check:html": "html-validate dist/",
    "audit:pages": "node scripts/audit.mjs",
    "indexnow": "node scripts/indexnow.mjs",
    "og-images": "node scripts/og-images.mjs",
    "check": "npm run build && npm run check:affiliate && npm run check:secrets && npm run check:headers && npm run check:links && npm run check:html",
    "check:full": "npm run check && npm run audit:pages",
    "build:prod": "npm run build && npm run check:affiliate && npm run check:headers && npm run check:links && npm run check:prod"
  },
  "dependencies": {
    "@astrojs/sitemap": "3.7.4",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource/anton": "5.3.0",
    "astro": "7.4.4"
  },
  "devDependencies": {
    "axe-core": "4.14.0",
    "chrome-launcher": "1.2.2",
    "esbuild": "0.28.2",
    "html-validate": "11.17.0",
    "lighthouse": "13.5.0",
    "puppeteer-core": "25.16.0",
    "wrangler": "4.158.0"
  }
}
