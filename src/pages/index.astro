---
import Base from '../layouts/Base.astro';
import Callout from '../components/Callout.astro';
import Icon from '../components/Icon.astro';
import Scene from '../components/Scene.astro';
import ProductCards from '../components/ProductCards.astro';
import SelectionNav from '../components/SelectionNav.astro';
import { GUIDES } from '../config';

const steps = [
  { icon: 'battery', title: 'Calculez vos besoins', text: 'Listez vos appareils : le calculateur donne la capacité en Wh et la puissance en W à viser.', href: '/quelle-capacite-station-electrique/' },
  { icon: 'scale', title: 'Comparez les modèles', text: 'Capacité, puissance, entrée solaire, poids : les chiffres des fiches officielles, côte à côte.', href: '/station-electrique-portable-1000-wh/' },
  { icon: 'check', title: 'Choisissez sereinement', text: 'Vérifiez le prix du modèle retenu sur Amazon.fr et gardez nos conseils de sécurité en tête.', href: '/selection/' },
] as const;
---
<Base title="Station électrique portable : guides" wide>
  <section slot="hero" class="home-hero">
    <div class="wrap-wide home-hero-inner">
      <div class="home-hero-text">
        <p class="kicker">Énergie nomade</p>
        <h1>Choisir sa station électrique portable sans se tromper</h1>
        <p class="lead">Des guides clairs et sourcés pour trouver l'énergie adaptée à votre usage : camping-car, van, camping, coupure de courant ou chantier.</p>
        <div class="hero-actions">
          <a class="btn btn-lg" href="/quelle-capacite-station-electrique/">Calculer mes besoins</a>
          <a class="btn-ghost btn-lg" href="/selection/">Voir la sélection</a>
        </div>
        <ul class="hero-points">
          <li><Icon name="check" size={18} /> Calculateurs gratuits</li>
          <li><Icon name="check" size={18} /> Sources citées</li>
          <li><Icon name="check" size={18} /> Aucun avis inventé</li>
        </ul>
      </div>
      <div class="home-hero-art"><Scene name="home" /></div>
    </div>
  </section>

  <section class="section">
    <h2 class="section-title">Comment ça marche</h2>
    <ol class="steps">
      {steps.map((s, i) => (
        <li class="step">
          <span class="step-num">{i + 1}</span>
          <span class="step-icon"><Icon name={s.icon} size={24} /></span>
          <h3>{s.title}</h3>
          <p>{s.text}</p>
          <a href={s.href}>Commencer <Icon name="arrow" size={16} /></a>
        </li>
      ))}
    </ol>
  </section>

  <section class="section">
    <h2 class="section-title">Les guides</h2>
    <div class="cards">
      {GUIDES.map((g) => (
        <a class="card" href={g.href}>
          <span class="card-icon"><Icon name={g.icon} size={24} /></span>
          <span class="card-title">{g.title}</span>
          <span class="card-desc">{g.desc}</span>
          <span class="card-more">Lire le guide <Icon name="arrow" size={16} /></span>
        </a>
      ))}
    </div>
  </section>

  <section class="section">
    <h2 class="section-title">Notre sélection</h2>
    <ProductCards more={false} />
    <p><a class="link-arrow" href="/selection/">Voir toute la sélection <Icon name="arrow" size={16} /></a></p>
  </section>

  <section class="section prose">
    <h2 class="section-title">Pourquoi une station électrique portable ?</h2>
    <p>Une station électrique portable est une grosse batterie équipée de prises 230 V, de ports USB et souvent d'une entrée solaire. Contrairement à un groupe électrogène, elle ne brûle pas de carburant : elle est silencieuse et peut s'utiliser à l'abri. On l'emporte en van, en camping-car ou en camping, on la garde pour les coupures de courant, ou on s'en sert sur un chantier sans prise à proximité.</p>
    <p>Pour bien la choisir, deux chiffres comptent : sa capacité en wattheures (Wh), qui fixe combien de temps elle tient, et sa puissance de sortie en watts (W), qui fixe quels appareils elle peut alimenter. Nos guides vous aident à calculer les deux selon vos besoins réels.</p>
    <p>Nous n'avons testé aucun produit nous-mêmes : nos analyses reposent sur les caractéristiques publiées et des sources publiques, toujours citées.</p>
    <Callout type="warning" title="Sécurité">
      Une station électrique ne remplace ni une installation électrique ni une alimentation médicale vitale.
    </Callout>
  </section>
</Base>
