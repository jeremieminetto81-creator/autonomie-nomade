---
// Police des titres hébergée avec le site (aucune requête vers un serveur tiers).
import '@fontsource-variable/bricolage-grotesque/wght.css';
// Préchargement de la police des titres (elle dessine le plus gros élément de la page : meilleur LCP).
import latinFont from '@fontsource-variable/bricolage-grotesque/files/bricolage-grotesque-latin-wght-normal.woff2?url';
import '../styles/global.css';
import Icon from '../components/Icon.astro';
import { organization } from '../lib/schema';
import { SELECTIONS } from '../data/selections';
import { SITE_NAME, SITE_DESCRIPTION, NAV, GUIDES, AMAZON_MENTION, GOOGLE_SITE_VERIFICATION, BING_SITE_VERIFICATION } from '../config';
// wide : mise en page large (accueil, sélection). progress : barre de progression de lecture (guides).
interface Props { title: string; description?: string; noindex?: boolean; ogType?: 'website' | 'article'; wide?: boolean; progress?: boolean }
const { title, description = SITE_DESCRIPTION, noindex = false, ogType = 'website', wide = false, progress = false } = Astro.props;
const path = Astro.url.pathname;
const canonical = new URL(path, Astro.site).href;
// Image de partage : une par guide et pour la sélection, sinon l'image générale (voir scripts/og-images.mjs).
const ogPaths = [...GUIDES.map((g) => g.href as string), '/selection/'];
const ogImage = new URL(ogPaths.includes(path) ? `/og/${path.slice(1, -1)}.png` : '/og/default.png', Astro.site).href;
// Le nom du site n'est ajouté que si le titre complet reste sous 60 caractères (au-delà, Google le coupe).
const SUFFIX = ` | ${SITE_NAME}`;
const fullTitle = title.length + SUFFIX.length <= 60 ? `${title}${SUFFIX}` : title;
// WebSite : décrit le site entier, donc déclaré une seule fois, sur l'accueil.
const isHome = path === '/';
const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  description: SITE_DESCRIPTION,
  publisher: organization(Astro.site!),
  name: SITE_NAME,
  url: new URL('/', Astro.site).href,
  inLanguage: 'fr',
});
---
<!doctype html>
<html lang="fr">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <meta name="theme-color" content="#b23c0a">
  <link rel="preload" href={latinFont} as="font" type="font/woff2" crossorigin>
  <title>{fullTitle}</title>
  <meta name="description" content={description}>
  <link rel="canonical" href={canonical}>
  {noindex && <meta name="robots" content="noindex">}
  {GOOGLE_SITE_VERIFICATION && <meta name="google-site-verification" content={GOOGLE_SITE_VERIFICATION}>}
  {BING_SITE_VERIFICATION && <meta name="msvalidate.01" content={BING_SITE_VERIFICATION}>}
  <meta property="og:type" content={ogType}>
  <meta property="og:site_name" content={SITE_NAME}>
  <meta property="og:locale" content="fr_FR">
  <meta property="og:title" content={fullTitle}>
  <meta property="og:description" content={description}>
  <meta property="og:url" content={canonical}>
  <meta property="og:image" content={ogImage}>
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:image:alt" content={title}>
  <meta name="twitter:card" content="summary_large_image">
  {isHome && <script type="application/ld+json" set:html={jsonLd}></script>}
  <slot name="head" />
</head>
<body>
  <a class="skip" href="#contenu">Aller au contenu</a>
  {progress && <div class="read-progress" aria-hidden="true"><span id="read-progress-bar"></span></div>}
  <header class="site-header">
    <div class="wrap-wide header-inner">
      <a class="logo" href="/"><span class="logo-mark"><Icon name="battery" size={22} /></span>{SITE_NAME}</a>
      <nav class="main-nav" aria-label="Navigation principale">
        {NAV.map((n) => <a href={n.href} aria-current={path === n.href ? 'page' : undefined}>{n.label}</a>)}
      </nav>
    </div>
  </header>
  <main id="contenu">
    <slot name="hero" />
    <div class={wide ? 'wrap-wide' : 'wrap'}>
      <slot />
    </div>
  </main>
  <footer class="site-footer">
    <div class="wrap-wide">
      <div class="footer-cols">
        <div>
          <p class="footer-title">Guides</p>
          <ul>{GUIDES.map((g) => <li><a href={g.href}>{g.title}</a></li>)}</ul>
        </div>
        <div>
          <p class="footer-title">Sélections</p>
          <ul>{SELECTIONS.filter((s) => s.group === 'usage').map((s) => <li><a href={`/selection/${s.slug}/`}>{s.short}</a></li>)}</ul>
        </div>
        <div>
          <p class="footer-title">Le site</p>
          <ul>
            <li><a href="/a-propos/">Notre méthode et affiliation</a></li>
            <li><a href="/mentions-legales/">Mentions légales</a></li>
            <li><a href="/confidentialite/">Confidentialité</a></li>
          </ul>
        </div>
      </div>
      <p class="footer-note">{AMAZON_MENTION}</p>
      <p class="footer-note">{SITE_NAME} · guides indépendants sur l'énergie nomade</p>
    </div>
  </footer>
  {progress && <script src="/progress.js" defer></script>}
</body>
</html>
