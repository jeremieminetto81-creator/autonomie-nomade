---
// Illustrations maison (formes simples, aucune image externe). Couleurs via les classes sc-* de global.css.
interface Props { name: 'home' | 'capacity' | 'generator' | 'solar' | 'compare' | 'selection' }
const { name } = Astro.props;
---
<svg class="scene" viewBox="0 0 320 220" aria-hidden="true" focusable="false">
  <circle class="sc-glow" cx="160" cy="118" r="96" />
  {(name === 'home' || name === 'solar') && (
    <g>
      <circle class="sc-sun" cx="248" cy="52" r="20" />
      <path class="sc-ray" d="M248 18v-10M248 96v-10M214 52h-10M292 52h-10M224 28l-7-7M279 83l-7-7M224 76l-7 7M279 21l-7 7" />
      <path class="sc-panel" d="M30 168l26-62h70l-26 62z" />
      <path class="sc-panel-line" d="M43 137h70M59 106l-16 62M82 106l-16 62M105 106l-16 62" />
      <path class="sc-cable" d="M100 168c20 14 40 14 60 0" />
    </g>
  )}
  {name === 'capacity' && (
    <g>
      <path class="sc-gauge-bg" d="M40 150a60 60 0 0 1 120 0" />
      <path class="sc-gauge" d="M40 150a60 60 0 0 1 96-48" />
      <path class="sc-needle" d="M100 150l30-34" />
      <circle class="sc-dot" cx="100" cy="150" r="7" />
    </g>
  )}
  {name === 'generator' && (
    <g>
      <rect class="sc-can" x="34" y="112" width="58" height="66" rx="8" />
      <path class="sc-can-cap" d="M48 112v-14h24v14M70 98l12-10" />
      <path class="sc-cross" d="M50 132l26 26M76 132l-26 26" />
    </g>
  )}
  {name === 'compare' && (
    <g>
      <path class="sc-balance" d="M160 40v140M120 186h80M70 70h180" />
      <path class="sc-balance" d="M70 70l-24 50h48zM250 70l-24 50h48z" />
    </g>
  )}
  {name === 'selection' && (
    <g>
      <rect class="sc-card" x="28" y="70" width="80" height="104" rx="10" />
      <rect class="sc-card" x="212" y="70" width="80" height="104" rx="10" />
      <path class="sc-check" d="M52 122l12 12 22-26M236 122l12 12 22-26" />
    </g>
  )}
  <g class={name === 'compare' ? 'sc-station sc-small' : 'sc-station'}>
    <rect class="sc-handle" x="168" y="96" width="64" height="18" rx="6" />
    <rect class="sc-body" x="140" y="110" width="120" height="78" rx="14" />
    <rect class="sc-screen" x="156" y="126" width="46" height="28" rx="5" />
    <path class="sc-bolt" d="M182 131l-8 10h8l-6 9" />
    <circle class="sc-port-a" cx="222" cy="140" r="6" />
    <circle class="sc-port-b" cx="242" cy="140" r="6" />
    <rect class="sc-bar" x="156" y="166" width="88" height="8" rx="4" />
  </g>
</svg>
